dispatch minecraft:storage["ifsou:var"] to var

use ::java::data::dialog::Button
use ::java::world::item::ItemBase
use ::java::world::item::ItemStack
use ::java::data::advancement::predicate::EnchantmentPredicate
use ::mcdoc::ifsou::recipe::InfusionAltar

struct var {
    structure_check?: struct {
        x: int,
        y: int,
        z: int,
        func: #[id="function"] string,
    },
    kill_timer?: struct {
        timer_tick: int,
    },
    dialog?: struct {
        actions?: [Button],
    },
    running: struct {
        tick?: int,
        stop?: BOOL,
        targetEntity?: HexUUID,
        items?: [ItemStack],
        hash?: #[nbt] string,
        absorbingItem?: struct {
            id: #[id="item"] string,
            component?: ItemBase,
        },
        UUID?: HexUUID,
        PlayerName?: #[match_regex="[a-z0-9_]{1,16}"] string,
    },
    //用于限制马脚魔咒1tick只执行1次
    horse_foot?: struct {
        last: int,
        now: int,
    },
    depth_digger?: struct {
        //用于显示深度矿工的挖掘加速数值
        speed?: float,
    },
    rushing_stream?: struct {
        had_log?: BOOL,
        log?: (BlockCoordinates | any),
        logs?: [[(BlockCoordinates | any)]],
        alreayAdded?: [BlockCoordinates],
        currentLayer?: [BlockCoordinates],
    },
}

struct entityData {
    data: struct {
        "ifsou:trigger"?: struct {
            cacheHash: #[nbt] string,
            items: [ItemStack],
            R: InfusionAltar,
        },
        "ifsou:player"?: struct {
            UUID: HexUUID,
            enchantments?: EnchantmentPredicate,
        },
        "ifsou:rushing_stream"?: struct {
            logs: [[BlockCoordinates]],
        },
    },
}

enum(byte) BOOL {
    TRUE = 1b,
    FALSE = 0b,
}

type HexUUID = (
    #[match_regex="[a-z0-9]{8}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{12}"] string |
)

type BlockCoordinates = struct {
    x: int,
    y: int,
    z: int,
}
